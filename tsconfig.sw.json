{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "types": ["vite/client"]
  },
  "include": ["src/sw", "src/lib/pwa/constants.ts", "src/lib/pwa/swCore.ts", "src/lib/pwa/pushPayload.ts"]
}
