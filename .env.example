# Supabase — required. Get these from your Supabase project settings.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Legacy — used by the pre-pivot subscription checkout flow.
VITE_CHECKOUT_URL=

# Analytics — optional. Leave blank to run without analytics; each provider
# only initializes if its key is set (see src/lib/analytics.ts).
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA4_ID=
# PostHog project API key (starts with "phc_") and host.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
