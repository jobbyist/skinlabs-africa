# Copy to .env and fill in real values for local development.
# VITE_SUPABASE_PUBLISHABLE_KEY is Supabase's public/anon key — safe for client bundles
# by design (data access is controlled by Row Level Security, not by hiding this key).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_CHECKOUT_URL="https://shop.example.com/checkout"

# Calendly scheduling link for the /partners "Book a Partnership Call" embed.
# Leave blank to show the email fallback instead of embedding a placeholder.
VITE_SKINLABS_CALENDLY_URL=""

# Pexels API key (preferred for briefing/cover thumbnails)
# Get a free key at https://www.pexels.com/api/
# Rate limits: 200 requests/hour, 20 000/month on the free tier.
VITE_PEXELS_API_KEY=""

# Unsplash API Access Key (fallback when Pexels is unavailable)
# Get your key at https://unsplash.com/oauth/applications
VITE_UNSPLASH_ACCESS_KEY=""

# Formspree endpoint for the /brand-ambassadors application form.
VITE_FORMSPREE_BRAND_AMBASSADOR_ENDPOINT=""

# --- Server-only secrets (Vercel serverless functions under /api — never prefix with
# VITE_, never referenced from src/, never sent to the browser) ---

# Supabase service_role key — used by api/admin-analytics.ts to verify the caller's access
# token and confirm they hold the `admin` role. /admin itself signs in through the normal
# Supabase auth UI; there is no separate admin password.
SUPABASE_SERVICE_ROLE_KEY=""

# --- PWA / Web Push (docs/pwa.md) ---
# PUBLIC_CLIENT_CONFIG (safe in the browser bundle):
# VAPID public key for Web Push. Generate a pair once with `npx web-push generate-vapid-keys`.
# Leave blank to keep push notifications switched off (the UI says so honestly).
VITE_VAPID_PUBLIC_KEY=""

# SERVER_SECRET_CONFIG — NOT set here. These are Supabase Edge Function secrets for `push-send`
# (`supabase secrets set …`); never put them in .env, the repo, or any VITE_ variable:
#   VAPID_PUBLIC_KEY=<same value as VITE_VAPID_PUBLIC_KEY>
#   VAPID_PRIVATE_KEY=<the private half — keep secret>
#   VAPID_SUBJECT=mailto:support@skinlabs.co.za
